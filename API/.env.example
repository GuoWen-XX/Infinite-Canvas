# Infinite-Canvas API Keys Template
# Copy this file to API/.env and fill in real values. NEVER commit API/.env.

# --- 安全访问令牌 / LAN Access Token ---
# 局域网/公网部署访问令牌（强烈建议配置；留空则全网段无认证访问）
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
IC_ACCESS_TOKEN=

# --- ModelScope (free image/video inference) ---
MODELSCOPE_API_KEY=

# --- Antigravity CLI (agy) uses local login state, no key needed here ---

# --- RunningHub (video workflows) ---
RUNNINGHUB_API_KEY=
RUNNINGHUB_WALLET_API_KEY=

# --- Agnes AI (video) ---
API_PROVIDER_AGNES_AI_KEY=

# --- DashScope / Alibaba Bailian (wan3.0, happyhorse-1.1) ---
DASHSCOPE_API_KEY=

# --- ComfyUI local endpoint (optional override) ---
COMFYUI_URL=http://127.0.0.1:8188

# --- Local proxy for providers needing it (agy token refresh etc.) ---
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1

# --- Antigravity video timeout (seconds) ---
ANTIGRAVITY_IMAGE_TIMEOUT=600
